{
  "name": "the-daily-web",
  "version": "1.0.0",
  "description": "The Daily Web — Modern News Publishing & Management Platform (Course Final Project)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldarush/the-daily-web.git"
  },
  "keywords": [
    "news",
    "express",
    "mongodb",
    "mongoose",
    "ejs",
    "vanilla-js",
    "mvc",
    "the-daily-web"
  ],
  "author": "Eldar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/eldarush/the-daily-web/issues"
  },
  "homepage": "https://github.com/eldarush/the-daily-web#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middlewares/**/*.js",
      "routes/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 95,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
