# Server
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/the_daily_web

# Session Secret (survives restarts with connect-mongo)
SESSION_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Free Open-Meteo API: coordinates must match the display name
WEATHER_CITY=Tel Aviv
WEATHER_LATITUDE=32.0853
WEATHER_LONGITUDE=34.7818
