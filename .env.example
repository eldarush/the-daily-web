# Server
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/the_daily_web

# Session Secret (survives restarts with connect-mongo)
SESSION_SECRET=the-daily-web-secret-key-development

# External Weather API (Optional OpenWeatherMap API Key)
OPENWEATHER_API_KEY=
WEATHER_CITY=Tel Aviv
