<div class="weather-card" id="weather-widget">
  <div class="weather-header">
    <span class="weather-title">Current Weather</span>
    <span class="weather-city-badge" id="weather-city">Tel Aviv</span>
  </div>
  <div class="weather-body">
    <div class="weather-main-info">
      <span class="weather-temp" id="weather-temp">--°C</span>
      <span class="weather-desc" id="weather-desc">Loading conditions...</span>
    </div>
    <div class="weather-icon-wrapper" id="weather-icon-container">
      <span class="weather-icon-emoji" id="weather-icon">🌤️</span>
    </div>
  </div>
  <div class="weather-footer">
    <span class="weather-cache-tag" id="weather-cache-status">Cached (Max 15 min)</span>
    <time class="weather-updated-time" id="weather-updated">--</time>
  </div>
</div>
